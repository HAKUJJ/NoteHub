{
  "name": "notehub-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:typecheck": "tsc --ignoreConfig --noEmit --target es2023 --module nodenext --strict --skipLibCheck prisma/seed.ts prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "^5.104.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "^5.7.47",
    "oxlint": "^1.81.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
