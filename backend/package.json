{
  "name": "@notehub/backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests prisma",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --env-file=.env tests/integration.ts",
    "test:auth": "tsx --env-file=.env tests/auth-live.ts",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:status": "prisma migrate status",
    "db:verify": "tsx --env-file=.env scripts/verify-connection.ts",
    "db": "npm run db:verify",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.99.2",
    "cors": "2.8.5",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "~6.0.2"
  }
}
