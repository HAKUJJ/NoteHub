generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Supabase owns auth.users. The migration adds profiles.id -> auth.users.id.
// Do not use db push/migrate dev to manage the auth schema or this SQL-only FK.
model Profile {
  id          String     @id @db.Uuid
  displayName String     @map("display_name") @db.VarChar(100)
  avatar      String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  notes       Note[]
  favorites   Favorite[]
  bookFavorites BookFavorite[]

  @@map("profiles")
}

model Subject {
  code  String @id @db.VarChar(20)
  name  String @unique @db.VarChar(100)
  notes Note[]

  @@map("subjects")
}

model GradeLevel {
  code      String @id @db.VarChar(20)
  name      String @unique @db.VarChar(50)
  sortOrder Int    @unique @map("sort_order")
  notes     Note[]

  @@map("grade_levels")
}

model Note {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String     @db.VarChar(200)
  description String     @default("")
  content     String     @default("")
  subjectName String     @default("") @map("subject_name") @db.VarChar(100)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  attachment  Json?
  image       String?    @db.Text
  status      String     @default("approved") @db.VarChar(10)
  type        String     @default("note") @db.VarChar(10)
  subjectCode String     @map("subject_code") @db.VarChar(20)
  gradeCode   String     @map("grade_code") @db.VarChar(20)
  authorId    String     @map("author_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  subject     Subject    @relation(fields: [subjectCode], references: [code], onDelete: Restrict)
  gradeLevel  GradeLevel @relation(fields: [gradeCode], references: [code], onDelete: Restrict)
  author      Profile    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  favorites   Favorite[]

  @@index([subjectCode])
  @@index([gradeCode])
  @@index([authorId])
  @@index([createdAt, id])
  @@map("notes")
}

model BookFavorite {
  userId String @map("user_id") @db.Uuid
  bookId String @map("book_id") @db.VarChar(30)
  title String @db.VarChar(500)
  subtitle String @default("") @db.VarChar(1000)
  coverId Int? @map("cover_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
  @@map("book_favorites")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  noteId    String   @map("note_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "favorites_user_id_fkey")
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade, map: "favorites_note_id_fkey")

  @@id([userId, noteId], map: "favorites_pkey")
  @@index([noteId], map: "favorites_note_id_idx")
  @@map("note_favorites")
}
