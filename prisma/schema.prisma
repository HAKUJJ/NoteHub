generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Supabase owns auth.users. The migration adds profiles.id -> auth.users.id.
// Do not use db push/migrate dev to manage the auth schema or this SQL-only FK.
model Profile {
  id          String     @id @db.Uuid
  displayName String     @map("display_name") @db.VarChar(100)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  notes       Note[]
  favorites   Favorite[]

  @@map("profiles")
}

model Subject {
  code  String @id @db.VarChar(20)
  name  String @unique @db.VarChar(100)
  notes Note[]

  @@map("subjects")
}

model GradeLevel {
  code      String @id @db.VarChar(20)
  name      String @unique @db.VarChar(50)
  sortOrder Int    @unique @map("sort_order")
  notes     Note[]

  @@map("grade_levels")
}

model Note {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String     @db.VarChar(200)
  description String     @default("")
  type        String     @default("note") @db.VarChar(10)
  subjectCode String     @map("subject_code") @db.VarChar(20)
  gradeCode   String     @map("grade_code") @db.VarChar(20)
  authorId    String     @map("author_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  subject     Subject    @relation(fields: [subjectCode], references: [code], onDelete: Restrict)
  gradeLevel  GradeLevel @relation(fields: [gradeCode], references: [code], onDelete: Restrict)
  author      Profile    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  favorites   Favorite[]

  @@index([subjectCode])
  @@index([gradeCode])
  @@index([authorId])
  @@map("notes")
}

model Favorite {
  userId    String   @map("user_id") @db.Uuid
  noteId    String   @map("note_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([noteId])
  @@map("favorites")
}
